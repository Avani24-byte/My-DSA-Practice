//Problem : Running sum of 1d Array
//Approach : Prefix Sum
//Difficulty: easy
//Time Complexity: O(n)
//Space Complexity: O(1)

class Solution {
    public int[] runningSum(int[] nums) {
        
        for(int i = 1; i < nums.length; i++) {
            nums[i] = nums[i] + nums[i - 1];
        }
        
        return nums;
    }
}
        
//Problem : Missing number
//Approach: Math
//Difficulty: Easy
//Time Complexity: O(n)
//Space Complexity: O(1)

class Solution {
    public int missingNumber(int[] nums) {
        
        int n = nums.length;
        int sum = n * (n + 1) / 2;

        for (int num : nums) {
            sum -= num;
        }

        return sum;
    }
}
        

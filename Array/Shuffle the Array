//Problem: Shuffle the Array
//Approach: Array
//Time Complexity: O(n)
//Space Complexity: O(n)
//Difficulty: Easy

class Solution {
    public int[] shuffle(int[] nums, int n) {
        int[] ans = new int[nums.length];

        int j = 0;

        for (int i = 0; i < n; i++) {
            ans[j++] = nums[i];
            ans[j++] = nums[i + n];
        }

        return ans;
    }
}